{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run prisma:generate && npm run build",
    "startCommand": "npm run start:prod"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "healthCheck": {
    "path": "/api/health",
    "port": 4000
  },
  "environments": {
    "railway": {
      "variable": []
    }
  }
}
